{
  "name": "realm-lore",
  "version": "2026.5.5",
  "author": {
    "name": "OddOmens",
    "email": "hello@oddomens.com"
  },
  "description": "A local-first worldbuilding application.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5180 && NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:all": "vite build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.realmlore.app",
    "productName": "Realm Lore",
    "artifactName": "realm-lore-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Productivity"
    }
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "epub-gen-memory": "^1.1.2",
    "express": "^5.2.1",
    "fantasy-name-generator": "^2.0.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "react-textarea-autosize": "^8.5.9",
    "react-window": "^2.2.7",
    "uuid": "^14.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10",
    "wait-on": "^9.0.6"
  }
}
